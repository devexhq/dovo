{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://src.io/schemas/v1/workflow.json",
  "title": "Dovo Workflow Definition V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "name",
    "id",
    "steps"
  ],
  "properties": {
    "version": {
      "oneOf": [
        { "type": "integer", "const": 1 },
        { "type": "string", "const": "1.0" }
      ]
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string"
    },
    "timeout_seconds": {
      "type": "integer",
      "minimum": 1
    },
    "env": {
      "type": "object",
      "additionalProperties": { "type": "string" }
    },
    "inputs": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "type": {
            "type": "string",
            "enum": ["string", "boolean", "integer"],
            "default": "string"
          },
          "description": { "type": "string" },
          "required": { "type": "boolean" },
          "default": {
            "oneOf": [
              { "type": "string" },
              { "type": "boolean" },
              { "type": "integer" },
              { "type": "null" }
            ]
          },
          "aliases": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          }
        }
      }
    },
    "defaults": {
      "$ref": "#/$defs/blueprint_defaults"
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/step"
      }
    }
  },
  "$defs": {
    "blueprint_defaults": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "on_failure": {
          "oneOf": [
            { "type": "string", "enum": ["abort", "continue", "prompt_user", "retry"] },
            { "$ref": "#/$defs/failure_spec" }
          ]
        }
      }
    },
    "step": {
      "oneOf": [
        { "$ref": "#/$defs/standard_step" },
        { "$ref": "#/$defs/loop_step" }
      ]
    },
    "standard_step": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id"],
      "oneOf": [
        {
          "required": ["uses"],
          "not": { "required": ["run"] }
        },
        {
          "required": ["run"],
          "not": { "required": ["uses"] }
        }
      ],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "name": { "type": "string" },
        "uses": { "type": "string", "minLength": 1 },
        "run": { "type": "string", "minLength": 1 },
        "prompt": { "type": "string" },
        "tools": {
          "type": "array",
          "items": { "type": "string" }
        },
        "env": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        },
        "timeout_seconds": { "type": "integer", "minimum": 1 },
        "assert": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "exit_code": {
              "oneOf": [
                { "type": "integer" },
                { "type": "array", "items": { "type": "integer" }, "minItems": 1 }
              ]
            },
            "output_contains": {
              "oneOf": [
                { "type": "string" },
                { "type": "array", "items": { "type": "string" } }
              ]
            },
            "output_not_contains": {
              "oneOf": [
                { "type": "string" },
                { "type": "array", "items": { "type": "string" } }
              ]
            },
            "regex_match": { "type": "string" },
            "json_match": { "type": "object", "additionalProperties": true },
            "file_exists": {
              "oneOf": [
                { "type": "string", "minLength": 1 },
                {
                  "type": "array",
                  "items": { "type": "string", "minLength": 1 },
                  "minItems": 1
                }
              ]
            },
            "file_not_exists": {
              "oneOf": [
                { "type": "string", "minLength": 1 },
                {
                  "type": "array",
                  "items": { "type": "string", "minLength": 1 },
                  "minItems": 1
                }
              ]
            },
            "file_not_empty": {
              "oneOf": [
                { "type": "string", "minLength": 1 },
                {
                  "type": "array",
                  "items": { "type": "string", "minLength": 1 },
                  "minItems": 1
                }
              ]
            }
          }
        },
        "on_failure": {
          "oneOf": [
            { "type": "string", "enum": ["abort", "continue", "prompt_user", "retry"] },
            { "$ref": "#/$defs/failure_spec" }
          ]
        }
      }
    },
    "loop_step": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "until", "do"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "type": { "type": "string", "const": "loop" },
        "max_iterations": { "type": "integer", "minimum": 1, "default": 5 },
        "until": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string" }
        },
        "do": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/standard_step" }
        },
        "on_max_iterations": {
          "type": "string",
          "enum": ["abort", "continue", "prompt_user"]
        }
      }
    },
    "failure_spec": {
      "type": "object",
      "additionalProperties": false,
      "required": ["action"],
      "properties": {
        "action": { "type": "string", "enum": ["abort", "continue", "prompt_user", "retry"] },
        "max_retries": { "type": "integer", "minimum": 1 },
        "backoff_ms": { "type": "integer", "minimum": 0 },
        "on_max_retries": { "type": "string", "enum": ["abort", "continue", "prompt_user"] }
      }
    }
  }
}
