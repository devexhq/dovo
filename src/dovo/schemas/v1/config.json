{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://src.io/schemas/v1/config.json",
  "title": "Dovo Config V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "project"
  ],
  "properties": {
    "version": {
      "type": "integer",
      "const": 1
    },
    "project": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name"],
      "properties": {
        "name": { "type": ["string", "null"] },
        "initialized_at": { "type": ["string", "null"] }
      }
    },
    "ignore_global_root_error": { "type": "boolean" },
    "worktree": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "base_ref": { "type": "string", "minLength": 1 },
        "max_active_worktrees": { "type": "integer", "minimum": 1 },
        "default_timeout_seconds": { "type": "integer", "minimum": 1 }
      }
    },
    "agent": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "provider": { "type": "string", "enum": ["copilot"], "default": "copilot" },
        "model": { "type": ["string", "null"], "minLength": 1 },
        "endpoint": { "type": ["string", "null"], "minLength": 1 },
        "temperature": { "type": "number", "minimum": 0, "maximum": 2 },
        "max_tokens": { "type": "integer", "minimum": 1 },
        "env_passthrough": {
          "type": "array",
          "items": { "type": "string", "pattern": "^[^=\\u0000*\\s]+\\*?$" },
          "default": []
        },
        "env_mode": { "type": "string", "enum": ["allowlist", "inherit"], "default": "allowlist" },
        "tools": { "$ref": "#/$defs/toolPolicy" }
      }
    },
    "history": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "save_attempt_logs": { "type": "boolean" },
        "save_agent_payloads": { "type": "boolean" },
        "save_final_diff": { "type": "boolean" },
        "max_sessions": { "type": "integer", "minimum": 1 }
      }
    },
    "doctor": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "check_git": { "type": "boolean" },
        "check_paths_writable": { "type": "boolean" },
        "check_config_schema": { "type": "boolean" },
        "check_stale_worktrees": { "type": "boolean" },
        "check_required_binaries": { "type": "boolean" }
      }
    },
    "prune": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "remove_stale_worktrees": { "type": "boolean" },
        "remove_orphaned_worktrees": { "type": "boolean" },
        "remove_expired_artifacts": { "type": "boolean" },
        "artifact_ttl_days": { "type": "integer", "minimum": 0 }
      }
    },
    "telemetry": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" }
      }
    },
    "concurrency": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "lock_timeout_seconds": { "type": "number", "minimum": 0.1 }
      }
    },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "sensitive_variables": {
          "type": "array",
          "items": { "type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$" }
        }
      }
    }
  },
  "$defs": {
    "toolPolicy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "allow": { "type": "array", "items": { "$ref": "#/$defs/toolRule" }, "default": [] },
        "deny": { "type": "array", "items": { "$ref": "#/$defs/toolRule" }, "default": [] },
        "allow_all": { "type": "boolean", "default": false }
      }
    },
    "toolRule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["capability"],
      "properties": {
        "capability": { "type": "string", "enum": ["shell", "read", "write", "network", "mcp"] },
        "root": { "type": ["string", "null"], "enum": ["worktree", "scratch", null] },
        "pattern": { "type": ["string", "null"], "minLength": 1 }
      }
    }
  }
}
